  "merge": [
    {
      "name": "night rule hides apps and swaps theme",
      "config": {
        "version": 1,
        "theme": {"background": "#101010", "foreground": "#FFFFFF"},
        "dock": {"apps": ["com.a", "com.b"]},
        "drawer": {"hidden": ["com.x"]},
        "rules": [
          {"name": "night", "from": "22:00", "to": "07:00", "hide": ["com.b", "com.c"], "set": {"theme": {"background": "#000000"}}},
          {"name": "weekend", "days": ["sat", "sun"], "set": {"dock": {"apps": ["com.d"]}}}
        ]
      },
      "day": 6, "time": "23:00",
      "expect": {
        "active": ["night", "weekend"],
        "hidden": ["com.b", "com.c"],
        "theme": {"background": "#000000", "foreground": "#FFFFFF"},
        "dock_apps": ["com.d"]
      }
    },
    {
      "name": "no rule active leaves config untouched",
      "config": {
        "version": 1,
        "theme": {"background": "#101010"},
        "dock": {"apps": ["com.a"]},
        "rules": [{"name": "night", "from": "22:00", "to": "07:00", "hide": ["com.a"]}]
