{
  "version": 1,
  "name": "Minimal text",
  "theme": {
    "background": "#000000",
    "foreground": "#EDEDED",
    "secondary": "#6E6E73",
    "accent": "#FFFFFF",
    "font": "light",
    "textSize": 24,
    "iconStyle": "none",
    "padding": 32
  },
  "home": [
    {"type": "clock", "format": "HH:mm", "size": 72, "showDate": true, "dateFormat": "EEEE d MMMM"},
    {"type": "spacer", "flex": 1},
    {"type": "apps", "style": "list", "apps": ["@dialer", "@sms", "@browser", "@camera", "@settings"]},
    {"type": "spacer", "height": 24}
  ],
  "dock": {"apps": []},
  "drawer": {"style": "list", "showSearch": true, "autoLaunch": true},
  "gestures": {"swipeUp": "search", "swipeDown": "notifications", "doubleTap": "none", "longPress": "homeSettings"},
  "rules": [
    {
      "name": "Wind down",
      "from": "22:00",
      "to": "07:00",
      "set": {"theme": {"foreground": "#B0B0B0", "iconStyle": "none"}}
    }
  ]
}
